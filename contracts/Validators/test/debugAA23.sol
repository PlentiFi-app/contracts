pragma solidity ^0.8.0;

import "forge-std/Test.sol";
import "forge-std/console.sol";

contract ValidatorTest is Test {
    // "to": "0xA215361b35B7AD3b2F5061a5Cf3d48C4b11d4c15",
    //     "from": "0x7D6863F41F685A1A1aeBF32Df011422B4aD8463F",
    // Your contract addresses
    address constant VALIDATOR =
        address(0xA215361b35B7AD3b2F5061a5Cf3d48C4b11d4c15);

    function setUp() public {
        // Setup state if needed
        vm.createSelectFork("http://192.168.1.5:8545");
    }

    function testUserOpValidation() public {
        console.log("Debug point 1");
        vm.record();
        // We can use vm.expectRevert to catch and inspect the revert
        vm.expectRevert(bytes("AA23 reverted"));
        // If you want to see the full trace:
        vm.startPrank(
            /* msg.sender */ 0x7D6863F41F685A1A1aeBF32Df011422B4aD8463F
        );

        // Recreate the exact call that failed
        (bool success, bytes memory data) = VALIDATOR.call(
            hex""
        );

        console2.log("Success: ", success);
        console2.logBytes(data);

        // Your call here
        vm.stopPrank();
        (bytes32[] memory reads, bytes32[] memory writes) = vm.accesses(
            address(VALIDATOR)
        );
        console.log("Storage reads:", reads.length);
    }
}
